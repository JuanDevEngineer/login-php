# ---------------------------------------------------------------------
# Front controller: todo lo que no sea un archivo real va a index.php
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # No reescribir recursos existentes (css, js, imágenes, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes

# ---------------------------------------------------------------------
# Cabeceras de seguridad
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    Header always set Content-Security-Policy "default-src 'self'; \
        script-src  'self' 'unsafe-inline' https://code.jquery.com https://cdn.jsdelivr.net https://stackpath.bootstrapcdn.com https://cdnjs.cloudflare.com https://cdn.datatables.net; \
        style-src   'self' 'unsafe-inline' https://stackpath.bootstrapcdn.com https://cdnjs.cloudflare.com https://cdn.datatables.net https://use.fontawesome.com https://fonts.googleapis.com; \
        font-src    'self' data: https://use.fontawesome.com https://fonts.gstatic.com https://cdnjs.cloudflare.com; \
        img-src     'self' data: blob:; \
        connect-src 'self'; \
        frame-ancestors 'none'; \
        base-uri 'self'; \
        form-action 'self';"

    # Activar solo detrás de HTTPS.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------
# Archivos y carpetas que nunca deben servirse
# ---------------------------------------------------------------------
<FilesMatch "^(\.env.*|composer\.(json|lock)|bootstrap\.php|autoload\.php|.*\.md)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|ini|conf|bak|dist|yml|yaml)$">
    Require all denied
</FilesMatch>

# El código fuente no es contenido web: solo index.php es alcanzable.
RedirectMatch 404 ^.*/(src|resources|database|vendor|libs|tests)(/|$)
