# Entorno: development | production
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Bogota

# URL base SIN barra final. Debe coincidir con dónde está montado el proyecto.
BASE_URL=http://localhost/login-php

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# SMTP. Si SMTP_HOST queda vacío, los correos se escriben al log en vez de enviarse.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=Admin

# Tamaño máximo de imagen de perfil, en bytes (2 MB por defecto)
UPLOAD_MAX_BYTES=2097152
