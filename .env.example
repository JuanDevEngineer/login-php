# Copia este archivo como ".env" y rellena los valores. NUNCA commitees .env.
APP_ENV=development

# Base de datos
DB_HOST=localhost:3306
DB_NAME=test
DB_USER=root
DB_PASS=

# SMTP (usa un App Password de Gmail o un proveedor transaccional como Mailgun/SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@ejemplo.com
SMTP_PASS=REEMPLAZAR_CON_APP_PASSWORD
SMTP_FROM=tu-correo@ejemplo.com

# URL base de la app (sin barra final)
BASE_URL=http://localhost:80/login-php
EMAIL_ADMIN=admin@ejemplo.com
