{
    "name": "cuadrosc99/login-php",
    "description": "Login PHP MVC — saneado (auditoría abril 2026).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "controllers/",
            "App\\Models\\": "model/",
            "App\\Helpers\\": "helpers/",
            "App\\Config\\": "config/"
        },
        "files": [
            "helpers/env.php",
            "helpers/csrf.php",
            "helpers/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
